[Unit]
Description=Private family tree portal
After=network.target

[Service]
Type=simple
User=treef
Group=treef
StateDirectory=treef
StateDirectoryMode=0700
WorkingDirectory=/opt/treef
EnvironmentFile=/etc/treef/portal.env
ExecStartPre=/usr/bin/node /opt/treef/portal/launch-check.cjs check
ExecStart=/usr/bin/node /opt/treef/portal/server.cjs
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
